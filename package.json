{
  "name": "playwrite-script-builder",
  "version": "1.0.4",
  "description": "Web-based Playwright Testing Tool — Visual test builder with element scanner and code generator",
  "main": "electron-main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:desktop": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"electron . --dev\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "compile": "tsc",
    "test": "playwright test",
    "install:browsers": "playwright install chromium",
    "start": "node dist/server/index.js",
    "start:desktop": "node download-icon.js && npm run build && npm run compile && electron .",
    "release": "npm run build && npm run compile && electron-builder --publish always"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.9",
    "express": "^4.21.0",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "sharp": "^0.35.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.playwright.builder",
    "productName": "Playwrite Script Builder",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.js",
      "package.json",
      "icon.png"
    ],
    "icon": "icon.png",
    "win": {
      "target": [
        "nsis"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "devarajwork",
      "repo": "Playwrite-code-writer"
    }
  }
}
